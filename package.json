{
  "name": "nest-idempotent",
  "version": "0.1.0",
  "description": "Declarative NestJS idempotency with atomic Redis and PostgreSQL stores",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ulrichheringer/nest-idempotent.git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:integration": "npm run build && node --test dist/test/*.integration.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^10.12.0",
    "pg": "^8.0.0",
    "prettier": "^3.0.0",
    "redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
